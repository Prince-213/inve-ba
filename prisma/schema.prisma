generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  dataBanks    DataBank[]
}

model DataBank {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  columns     Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       InventoryItem[]

  @@index([userId])
}

model InventoryItem {
  id         String   @id @default(cuid())
  dataBankId String
  values     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dataBank   DataBank @relation(fields: [dataBankId], references: [id], onDelete: Cascade)

  @@index([dataBankId])
}
